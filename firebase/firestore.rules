rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core Security Rules for Little Buddha App

    // Users can only read and write their own profile document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Lessons are publicly readable (age-tier filtering is handled client-side)
    match /lessons/{lessonId} {
      allow read: if true;
      
      // No writes from client apps
      allow write: if false; 
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function calculateAge() {
      let doc = getUserData();
      let birthYear = (doc != null && doc.data != null && 'birth_year' in doc.data) ? doc.data.birth_year : request.time.year();
      return request.time.year() - birthYear;
    }

    function isValidAgeTier(tier) {
      let age = calculateAge();
      return (tier == '0-7' && age <= 7) ||
             (tier == '8-12' && age > 7 && age <= 12) ||
             (tier == '13-18' && age > 12);
    }
  }
}
